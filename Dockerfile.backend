# cache-bust 2026-09-14: force Railway to fetch a fresh source snapshot instead of reusing sha256:b9b2ed68
FROM node:20-alpine AS builder
WORKDIR /app

# Install deps for the whole workspace (npm needs every workspace's package.json
# present to resolve the root lockfile, even though only backend+shared get built).
COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/
COPY apps/frontend/package.json apps/frontend/
COPY packages/shared/package.json packages/shared/
RUN apk add --no-cache python3 make g++
RUN npm install --production=false --workspace apps/backend --workspace packages/shared --legacy-peer-deps

COPY packages/shared packages/shared
COPY apps/backend apps/backend

# The shared package must be built first - its dist/ is what backend imports via the workspace symlink.
RUN npm run build --workspace packages/shared
RUN npm run build --workspace apps/backend

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/apps/backend/dist ./dist
COPY --from=builder /app/apps/backend/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
# npm workspace hoisting nests some deps under apps/backend/node_modules instead of
# the root (e.g. when a dep needs a different version of something than the rest of
# the tree - pdf-parse's debug@^3.1.0 vs a newer debug elsewhere). Those are invisible
# to the runner unless copied on top of the root node_modules explicitly.
COPY --from=builder /app/apps/backend/node_modules ./node_modules
COPY --from=builder /app/packages/shared/dist ./node_modules/@po-control-tower/shared/dist
COPY --from=builder /app/packages/shared/package.json ./node_modules/@po-control-tower/shared/package.json

EXPOSE 8001
CMD ["node", "dist/main.js"]
